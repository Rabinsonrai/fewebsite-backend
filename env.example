# Copy this file to .env and fill in your real values.

# Local Postgres:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/civil_engineering_tests

# Or a hosted Postgres (e.g. Render, Supabase, Neon, Railway) — looks like:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Most hosted providers require SSL. Set to "true" if you get an
# SSL-related connection error, leave as "false" for local Postgres.
DATABASE_SSL=false

PORT=5000
